      "id": "slides.templates.create",
      "upstream": {
        "baseUrl": "https://slides.googleapis.com/v1",
        "method": "POST",
        "path": "/files/{templateId}/copy + controlled replacement",
        "secondary": {
          "service": "drive",
          "baseUrl": "https://www.googleapis.com/drive/v3",
          "method": "POST",
          "path": "/files/{templateId}/copy"
        }
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "templateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "replacements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "find": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000
                },
                "replace": {
                  "type": "string",
                  "maxLength": 100000
                },
                "matchCase": {
                  "type": "boolean"
                }
              },
              "required": ["find", "replace", "matchCase"],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 100
          }
        },
        "required": ["templateId", "title", "replacements"],
        "additionalProperties": false
      },
      "authorization": {
        "subject": "exact selected Google OAuth user, app-scoped connection; no global account center",
        "acceptedAnyOfScopes": [
          "https://www.googleapis.com/auth/drive",
          "https://www.googleapis.com/auth/drive.file"
        ],
        "minimumRequestedScopes": ["https://www.googleapis.com/auth/drive"],
        "actualGrantedScopesRequired": true,
        "resourceAccessRequired": true,
        "conditionalScopeGuards": [
          "drive.file-only existing file: authoritative same-token Drive files.get(id,isAppAuthorized) must return same id and isAppAuthorized=true"
        ],
        "credentialSource": "backend bound grant only; business credential/header/URL fields are rejected",
        "scopeBoundary": "Product-specific Docs/Sheets/Slides scope covers accessible files for that product, not per-file consent. drive.file is limited to files opened/created by this OAuth app."
      },
      "readOnly": false,
      "effect": {
        "kind": "write",
        "remoteMutation": true,
        "existingApprovalPolicy": true,
        "recovery": "operationId + subject + tenant + exact intent hash; prepared/dispatching/committed ExternalEffect checkpoint; unknown outcome never blindly replays"
      },
      "concurrency": "copy has no atomic source revision; record source version. Fill uses copied requiredRevisionId. No compensation/deletion.",
      "pagination": {
        "mode": "none",
        "completeMeaning": "Only requested resource/range; never entire Drive or full account"
      },
      "runtimeRequirements": [
        "Drive API enabled for same OAuth client",
        "Same-token MIME/resource authority preflight",
        "Copies inherit Drive visibility; no public sharing requested"
      ],
      "sources": [
        "https://developers.google.com/workspace/slides/api/reference/rest/v1/presentations",
        "https://developers.google.com/workspace/drive/api/reference/rest/v3/files",
        "https://developers.google.com/workspace/drive/api/reference/rest/v3/files/copy"
      ],
