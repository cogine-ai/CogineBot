    {
      "id": "slack.users.resolve",
      "description": "Find a user by ID, email or name; return ambiguous candidates",
      "inputSchema": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Z][A-Z0-9]+$"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": ["userId"],
            "not": {
              "anyOf": [
                {
                  "required": ["email"]
                },
                {
                  "required": ["query"]
                }
              ]
            }
          },
          {
            "required": ["email"],
            "not": {
              "anyOf": [
                {
                  "required": ["userId"]
                },
                {
                  "required": ["query"]
                }
              ]
            }
          },
          {
            "required": ["query"],
            "not": {
              "anyOf": [
                {
                  "required": ["userId"]
                },
                {
                  "required": ["email"]
                }
              ]
            }
          }
        ]
      },
      "upstream": {
        "baseUrl": "https://slack.com/api",
        "method": "GET",
        "path": "/users.info",
        "branches": [
          {
            "when": "input.userId",
            "method": "GET",
            "path": "/users.info",
            "query": {
              "user": "input.userId"
            },
            "requiredScopes": ["users:read"]
          },
          {
            "when": "input.email",
            "method": "GET",
            "path": "/users.lookupByEmail",
            "query": {
              "email": "input.email"
            },
            "requiredScopes": ["users:read", "users:read.email"]
          },
          {
            "when": "input.query",
            "method": "GET",
            "path": "/users.list",
            "query": {
              "limit": "input.limit ?? 100",
              "cursor": "input.cursor when supplied"
            },
            "requiredScopes": ["users:read"],
            "pagination": "Return next_cursor and filter only this page; any next_cursor prevents treating one candidate as unique."
          }
        ]
      },
      "authorization": {
        "acceptedAnyOfScopes": ["users:read"],
        "actualGrantedScopesRequired": true,
        "credentialsInBusinessInput": false,
        "subject": "exact selected connection actor; no implicit default/account switching",
        "actors": ["bot", "user"],
        "conditionalGuards": [
          "Slack user history/files/search collection requires verified policy permission. Search also requires verified legacy permission; RTS is disabled."
        ],
        "conditionalScopeGuards": [
          {
            "when": "input.email",
            "requiredAllOfScopes": ["users:read", "users:read.email"],
            "missingScope": "Reject before dispatch; userId and query do not require email scope."
          }
        ]
      },
      "readOnly": true,
      "effect": {
        "kind": "read",
        "existingApprovalPolicy": true,
        "unknownOutcome": "No automatic replay after dispatch. Durable receipt binds action + operation + input digest + actor + tenant. Read exact stable IDs; matching text/time is not proof."
      },
      "outputContract": {
        "userId": "exact stable selected user ID",
        "email": "exact email lookup from users.lookupByEmail, requiring separate email grant",
        "query": "candidate array with ambiguous=true for multiple/zero matches or any unsearched next page",
        "emailDisclosure": "profile.email is returned only when actual users:read.email is present"
      }
    },
