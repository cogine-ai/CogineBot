    },
    {
      "id": "clickup.tasks.list",
      "description": "Read one page of tasks from a list.",
      "method": "GET",
      "path": "/api/v2/list/{listId}/task",
      "inputSchema": {
        "type": "object",
        "properties": {
          "listId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "page": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "includeClosed": {
            "type": "boolean"
