    "https://developer.clickup.com/reference/updatetask",
    "https://developer.clickup.com/reference/createtaskcomment"
  ],
  "errorPolicy": "401expired;403scope/ACL;404resource;409/412conflict;429retryAfter;5xxunavailable; acknowledgedunknownwrite never replay; never expose diagnostics/tokens",
  "acceptance": [
    "everyaction exactmethod/path/body fixture",
    "schemaunknownfield rejection beforeHTTP",
    "wrongactor/subject/tenant rejection",
    "paginationneverpretendallpages",
    "401/403/404/429 mapping",
    "writecheckpoint beforedispatch and no replay afterunknown",
    "authidentity/scopes/refreshnegative tests"
  ]
