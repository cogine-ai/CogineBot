  "authorization": {
    "credentialKinds": [
      "oauth",
      "personal_token"
    ],
    "identity": "GET /api/v2/user + GET /api/v2/team verifies actual user and authorized Workspace IDs. No tenantId selection: user may authorize multiple Workspaces; provider ACL per request.",
    "scopes": "No OAuth scopes API: do not fabricate; resource ACL checked by provider per request",
    "refresh": "No documented refresh; nonexpiring current token; revoked token reconnects",
    "events": "Signed workspace webhook available; no automatic registration or second consumer; only existing explicitly selected Routine framework may poll later",
    "rate": "HTTP429, plan-dependent100/1000/10000 requests/minute; respect Retry-After or X-RateLimit-Reset",
    "limits": "No custom fields, attachment upload, or task search implied by these8actions; update precheck notatomic"
  },
  "sources": [
    "https://developer.clickup.com/docs/authentication",
    "https://developer.clickup.com/docs/rate-limits",
    "https://developer.clickup.com/reference/gettasks",
