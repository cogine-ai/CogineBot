        "actor": "user",
        "acceptedAnyOfScopes": []
      },
      "externalEffect": "none",
      "pagination": "single page; explicit continuation, never claim full collection without terminal provider metadata"
    },
    {
      "id": "clickup.tasks.get",
      "description": "Read a ClickUp task.",
      "method": "GET",
      "path": "/api/v2/task/{taskId}",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "taskId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "action_id",
          "task"
        ],
        "properties": {
          "action_id": {
            "const": "clickup.tasks.get"
          },
          "task": {
            "type": "object"
          }
        }
      },
      "readOnly": true,
      "authorization": {
        "actor": "user",
        "acceptedAnyOfScopes": []
      },
      "externalEffect": "none",
      "pagination": "single page; explicit continuation, never claim full collection without terminal provider metadata"
    },
    {
      "id": "clickup.tasks.create",
      "description": "Create a task in a ClickUp list.",
      "method": "POST",
      "path": "/api/v2/list/{listId}/task",
      "inputSchema": {
        "type": "object",
        "properties": {
          "listId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50000
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "dueDate": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8640000000000000
          },
          "assignees": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true
          }
        },
        "required": [
          "listId",
          "name"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "action_id",
          "task"
        ],
        "properties": {
          "action_id": {
            "const": "clickup.tasks.create"
          },
          "task": {
            "type": "object"
          }
        }
      },
      "readOnly": false,
      "authorization": {
        "actor": "user",
        "acceptedAnyOfScopes": []
      },
      "externalEffect": "write resource on selected account; notifications may be emitted",
      "pagination": "single page; explicit continuation, never claim full collection without terminal provider metadata"
    },
    {
      "id": "clickup.tasks.update",
      "description": "Update a task after checking its last-read timestamp.",
      "method": "PUT",
      "path": "/api/v2/task/{taskId}",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "expectedDateUpdated": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "changes": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "description": {
                "type": "string",
                "maxLength": 50000
              },
              "status": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "due_date": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 8640000000000000
              }
            },
            "required": [],
            "additionalProperties": false,
            "minProperties": 1
          }
        },
        "required": [
          "taskId",
          "expectedDateUpdated",
          "changes"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "action_id",
          "task"
        ],
        "properties": {
          "action_id": {
            "const": "clickup.tasks.update"
          },
          "task": {
            "type": "object"
          }
        }
      },
      "readOnly": false,
      "authorization": {
        "actor": "user",
        "acceptedAnyOfScopes": []
      },
      "externalEffect": "write resource on selected account; notifications may be emitted",
      "pagination": "single page; explicit continuation, never claim full collection without terminal provider metadata"
    },
    {
      "id": "clickup.comments.create",
      "description": "Post a task comment.",
      "method": "POST",
      "path": "/api/v2/task/{taskId}/comment",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50000
          },
          "notifyAll": {
            "type": "boolean"
          }
        },
        "required": [
          "taskId",
          "text"
        ],
        "additionalProperties": false
