      "method": "GET",
      "path": "/api/v2/{parentType}/{parentId}/list",
      "inputSchema": {
        "type": "object",
        "properties": {
          "parentType": {
            "enum": [
              "space",
              "folder"
            ]
          },
          "parentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
