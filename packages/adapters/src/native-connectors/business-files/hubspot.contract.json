  "authorization": {
    "credentialKinds": ["oauth", "personal_token"],
    "identity": "2026-09 OAuth body introspection binds client_id/app_id/hub_id/user_id. signed_access_token.isUserLevel true -> user; false -> account app. private token info -> app actor, never user-row ACL promise.",
    "scopes": "crm.objects.contacts.read/write companies.read deals.read; product tier/recordACL remains upstream, not fabricate objects crm.objects.companies.write crm.objects.deals.write. Updates require corresponding read; deal stage changes require actual pipeline/stage verification and deals.read; association requires both selected object write scopes.",
    "refresh": "2026-09 fixed api.hubspot.com token endpoint, normal reusable refresh handling; newest refresh retained. Uncertain token response never silently reuse replaced material.",
    "events": "Webhook signing/appsubscription conditional; do not register without explicit admin config; polling not silently enabled",
    "rate": "429 Retry-After and X-HubSpot-RateLimit; search pagination limit10000; no write auto retries",
    "limits": "Contacts/company/deal CRUD only; deal pipeline metadata read, not pipeline mutation; default unlabeled associations limited to these3types. No arbitraryCRM object proxy, no customschemas. Best-effort timestamp check is not atomicCAS. Account-vs-user permission semantics explicit."
  },
