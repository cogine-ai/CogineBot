  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId    String
  space      Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId      String
  bot        Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  name       String
  origin     String
  auth       Json
  ciphertext String
  revision   String   @default(dbgenerated("gen_random_uuid()::text"))
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, spaceId, botId, name])
  @@index([botId])
  @@index([spaceId])
  @@map("bot_secrets")
  @@schema("public")
}

/// Deployment keys survive account and Space lifecycle changes.
model DeploymentIdentity {
  id             String @id @default("primary")
  deploymentId   String @unique
  publicKey      String
  fingerprint    String
  ciphertext     String
  secretRecordId String @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("deployment_identities")
  @@schema("public")
}

/// Scope ids are provenance, not authority. Unsettled provider writes must survive scope deletion.
model DeploymentTransferSession {
  id                   String @id
  side                 String
  targetTransferId     String
  localUserId          String
  localSpaceId         String
  localBotId           String
  localSessionId       String
  sourceOrigin         String
  targetOrigin         String
  sourceDeploymentId   String?
  sourcePublicKey      String?
  sourceFingerprint    String?
  targetDeploymentId   String
  targetPublicKey      String
  targetFingerprint    String
  remoteOwnerId        String?
  remoteSpaceId        String?
  remoteBotId          String?
  remoteOwnerGrantNonce String?
  localNonce           String
  peerNonce            String?
  targetBindingDigest  String
  proposalDigest       String?
  planDigest           String?
  proposalJson         Json?
  planJson             Json?
  revision             Int @default(1)
  status               String @default("created")
  clientNonce          String
  requestBinding       String
  tokenHash            String?
  ciphertext           String?
  secretRecordId       String?
  grantDelivery        String @default("none")
  acceptedNonce        String?
  consumedAt           DateTime?
  expiresAt            DateTime
  cancelRequestedAt    DateTime?
  writeRevokedAt       DateTime?
  writeRevokedReason   String?
  terminalAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  items                DeploymentTransferItem[]

  @@unique([localUserId, side, clientNonce])
  @@unique([side, targetOrigin, targetTransferId, localUserId, localSpaceId], map: "deployment_transfer_sessions_peer_owner_key")
  @@index([localUserId, localSpaceId, updatedAt], map: "deployment_transfer_sessions_owner_updated_idx")
  @@index([status, expiresAt], map: "deployment_transfer_sessions_status_expires_idx")
  @@map("deployment_transfer_sessions")
  @@schema("public")
}

model DeploymentTransferItem {
  id                     String @id
  sessionId              String
  session                DeploymentTransferSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  itemKey                String
  sourceBotId            String
  sourceSecretId         String
  sourceRevision         String
  targetBotId            String?
  targetName             String
  origin                 String
  auth                   Json
  expectedTargetId       String?
  expectedTargetRevision String?
  decision               String
  status                 String @default("pending")
  revision               Int @default(1)
  writeState             String @default("none")
  dispatchClaimId        String? @unique
  writeFence             Int @default(0)
  claimedAt              DateTime?
  secretRecordId         String?
  recoveryRef            String?
  ciphertext             String?
  targetSecretId         String?
  acceptedRevision       String?
  acceptedAt             DateTime?
  receiptJson            Json?
  cleanupState           String @default("none")
  reasonCode             String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([sessionId, itemKey])
  @@index([writeState, updatedAt])
  @@index([recoveryRef])
  @@map("deployment_transfer_items")
  @@schema("public")
}


model ExternalConversation {
  id                       String            @id @default(cuid())
  provider                 String
  workspaceId              String
  externalKey              String
  conversationId           String
  displayName              String?
  participantNames         String[]          @default([])
  teamChatAmbientEnabled   Boolean?
  teamChatRules            String?
  automatedSenderPolicies  Json              @default("{}")
  spaceId                  String
  space                    Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId                    String
  bot                      Bot               @relation(fields: [botId], references: [id], onDelete: Cascade)
  userId                   String
  thread                   Thread?
  messages                 ExternalMessage[]
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  @@unique([provider, workspaceId, externalKey])
  @@index([spaceId, botId])
  @@map("external_conversations")
  @@schema("public")
}

model ExternalMessage {
  id                     String                @id @default(cuid())
  externalConversationId String
  externalConversation   ExternalConversation  @relation(fields: [externalConversationId], references: [id], onDelete: Cascade)
  providerEventId        String
  kind                   String                @default("direct")
  senderId               String
  senderName             String
  senderIsBot            Boolean               @default(false)
  content                String
  replyThreadId          String?
  batchContext           String?
  engagementReason       String?
  judgedAt               DateTime?
  status                 String                @default("received")
  runId                  String?               @unique
  run                    Run?                  @relation(fields: [runId], references: [id], onDelete: SetNull)
  threadMessageId        String?               @unique
  threadMessage          Message?              @relation(fields: [threadMessageId], references: [id], onDelete: SetNull)
  attempts               Int                   @default(0)
  nextAttemptAt          DateTime?
  lastError              String?
  providerReplyHandle    String?
  deliveredAt            DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@unique([externalConversationId, providerEventId])
  @@index([status, nextAttemptAt])
  @@map("external_messages")
  @@schema("public")
}

model AgentSecret {
  id              String   @id @default(cuid())
  spaceId         String
  space           Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  name            String
  secretId        String   @unique
  secret          Secret   @relation(fields: [secretId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([spaceId, name])
  @@index([spaceId, updatedAt])
  @@map("agent_secrets")
  @@schema("public")
}

// Deployment-owned integration credentials; never exposed through read DTOs.
model IntegrationProviderConfig {
  id         String @id
  ciphertext String
  updatedAt  DateTime @updatedAt

  @@map("integration_provider_configs")
  @@schema("public")
}

model Board {
  id           String   @id @default(cuid())
  spaceId      String   @unique
  space        Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name         String   @default("Board")
  ticketPrefix String   @default("RAK")
  nextNumber   Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tickets      Ticket[]

  @@map("boards")
  @@schema("public")
}

model Ticket {
  id              String    @id @default(cuid())
  boardId         String
  board           Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  spaceId         String
  space           Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  number          Int
  title           String
  description     String?
  status          String    @default("todo")
  priority        String?
  assigneeBotId   String?
  assigneeBot     Bot?      @relation("TicketAssigneeBot", fields: [assigneeBotId], references: [id], onDelete: SetNull)
  createdByBotId  String?
  createdByBot    Bot?      @relation("TicketCreatorBot", fields: [createdByBotId], references: [id], onDelete: SetNull)
  createdByUserId String?
  createdByUser   User?     @relation("TicketCreatorUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  completedAt       DateTime?
  comments        TicketComment[]

  @@unique([boardId, number])
  @@index([spaceId, status])
  @@index([boardId, status])
  @@map("tickets")
  @@schema("public")
}

model TicketComment {
  id           String   @id @default(cuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  spaceId      String
  space        Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorBotId  String?
  authorBot    Bot?     @relation("TicketCommentAuthorBot", fields: [authorBotId], references: [id], onDelete: SetNull)
  authorUserId String?
  authorUser   User?    @relation("TicketCommentAuthorUser", fields: [authorUserId], references: [id], onDelete: SetNull)
  body         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([ticketId, createdAt])
  @@map("ticket_comments")
  @@schema("public")
}


// Application configuration belongs to this deployment, not to a model or Bot.
model NativeAppConfig {
  nativeSlackHooks NativeSlackHook[]
  nativeNotionHooks NativeNotionHook[]
  id String @id @default(cuid())
  appId String
  label String
  ownership String
  credentialKind String
  enabled Boolean @default(true)
  config Json @default("{}")
  ciphertext String?
  // SecretStore AAD identity; unlike a Secret row this has no User/Space lifecycle.
  secretRecordId String?
  callbackUri String
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions NativeOAuthSession[]
  grants NativeOAuthGrant[]
  connections Connection[]

  @@index([appId, enabled])
  @@map("native_app_configs")
  @@schema("public")
}

model NativeOAuthSession {
  id String @id
  stateHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId String
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  connectionId String @unique
  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  configId String
  config NativeAppConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  configRevision Int
  requestedScopes String[] @default([])
  secretId String?
  secret Secret? @relation(fields: [secretId], references: [id], onDelete: SetNull)
  expiresAt DateTime
  consumedAt DateTime?
  cancelledAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, spaceId, expiresAt])
  @@map("native_oauth_sessions")
  @@schema("public")
}

model NativeOAuthGrant {
  nativeEventTriggers NativeRoutineTrigger[]
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId String
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  configId String
  config NativeAppConfig @relation(fields: [configId], references: [id], onDelete: Restrict)
  configRevision Int
  authority String
  subject String
  tenant String?
  principal Json @default("{}")
  scopes String[] @default([])
  secretId String?
  secret Secret? @relation(fields: [secretId], references: [id], onDelete: SetNull)
  accessExpiresAt DateTime?
  authGeneration Int @default(1)
  tokenVersion Int @default(1)
  revokedAt DateTime?
  refreshLeaseId String?
  refreshLeaseUntil DateTime?
  // Linear rotation recovery is bounded from the first request, never from a later retry.
  refreshRecoveryUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  connections Connection[]

  @@index([userId, spaceId, authority])
  @@map("native_oauth_grants")
  @@schema("public")
}

model NativeRoutineTrigger {
  id String @id @default(cuid())
  routineId String
  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  connectionId String
  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  authorizationRevision String
  grantId String
  grant NativeOAuthGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  authGeneration Int
  configId String
  configRevision Int
  kind String
  resourceType String
  resourceId String
  spec Json
  version Int @default(1)
  armedAt DateTime @default(now())
  state Json @default("{}")
  nextPollAt DateTime?
  leaseId String?
  leaseUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([routineId])
  @@index([connectionId, authorizationRevision])
  @@index([nextPollAt])
  @@map("native_routine_triggers")
  @@schema("public")
}

model NativeNotionHook {
  id String @id
  configId String
  config NativeAppConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  configRevision Int
  revision Int @default(1)
  integrationId String?
  candidateIntegrationId String?
  subscriptionId String?
  // Deployment-level SecretStore AAD; independent of the setup owner's User/Space lifecycle.
  secretRecordId String? @unique
  ciphertext String?
  enabled Boolean @default(false)
  disabledAt DateTime?
  // Pending-setup provenance only; deliberately no User or Space FK/authority inheritance.
  setupOwnerUserId String
  setupSpaceId String
  setupExpiresAt DateTime
  ownerConfirmedAt DateTime?
  lastVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([integrationId, subscriptionId])
  @@index([configId])
  // SQL enforces one enabled hook per config with a partial unique index.
  @@map("native_notion_hooks")
  @@schema("public")
}


model NativeSlackHook {
  id String @id
  configId String
  config NativeAppConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  configRevision Int
  revision Int @default(1)
  deliveryRevision Int @default(1)
  appId String
  teamId String?
  botEvents String[]
  secretRecordId String? @unique
  ciphertext String?
  enabled Boolean @default(true)
  disabledAt DateTime?
  ownerConfirmedAt DateTime
  lastVerifiedAt DateTime?
  setupOwnerUserId String
  setupSpaceId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  inbox NativeSlackEventInbox[]
  @@index([configId])
  // SQL also enforces one enabled hook per app and per config (Slack has one Request URL).
  @@map("native_slack_hooks")
  @@schema("public")
}

model NativeSlackEventInbox {
  id String @id
  hookId String
  hook NativeSlackHook @relation(fields: [hookId], references: [id], onDelete: Cascade)
  hookRevision Int
  configRevision Int
  eventId String
  signal Json
  receivedAt DateTime @default(now())
  dispatchedAt DateTime?
  @@unique([hookId, eventId])
  @@index([dispatchedAt, receivedAt])
  @@map("native_slack_event_inbox")
  @@schema("public")
}

model Page {
  id             String        @id @default(cuid())
  spaceId        String
  space          Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  botId          String?
  bot            Bot?          @relation(fields: [botId], references: [id], onDelete: SetNull)
  groupId        String?
  group          ChatGroup?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title          String
  visibility     String        @default("private")
  pinnedAt       DateTime?
  currentVersion Int           @default(1)
  createdAt      DateTime      @default(now())
  /// Set when the page's content or title changes; pinning or sharing it is not an update.
  updatedAt      DateTime      @default(now())
  versions       PageVersion[]

  @@index([spaceId, userId, updatedAt])
  @@index([botId])
  @@index([groupId])
  @@map("pages")
  @@schema("cogine_pages")
}

model PageVersion {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version   Int
  title     String
  source    String
  /// The source compiled for the viewer when it was saved, so reads never run the compiler.
  code      String
  createdAt DateTime @default(now())

  @@unique([pageId, version])
  @@map("page_versions")
  @@schema("cogine_pages")
}
