generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas = ["public", "cogine_pages"]
}

model AiDataConsent {
  userId String
  spaceId String
  recipientKey String
  version String
  grantedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  spaceMember SpaceMember @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)

  @@id([userId, spaceId, recipientKey])
  @@map("ai_data_consents")
  @@schema("public")
}

model User {
  botPackagePreviews BotPackagePreview[]
  botPackageImports BotPackageImport[]
  openApiImportReceipts OpenApiImportReceipt[]
  aiDataConsents AiDataConsent[]
  id                          String                       @id
  name                        String
  email                       String
  emailVerified               Boolean                      @default(false)
  image                       String?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  avatarStyle                 String                       @default("robot")
  timezone                    String?
  sessions                    Session[]
  accounts                    Account[]
  members                     Member[]
  invitations                 Invitation[]
  modelCredentials            UserModelCredential[]
  voiceCredentials            UserVoiceCredential[]
  secrets                     Secret[]
  nativeOAuthSessions         NativeOAuthSession[]
  nativeOAuthGrants           NativeOAuthGrant[]
  mcpServers                  McpServer[]
  botSections                 BotSection[]
  actionApprovalRules         ActionApprovalRule[]
  actionAutoReviewPreferences ActionAutoReviewPreference[]
  createdSpaces               Space[]                      @relation("SpaceCreator")
  botSecrets BotSecret[]
  agentSecrets               AgentSecret[]
  createdTickets              Ticket[]                     @relation("TicketCreatorUser")
  ticketComments              TicketComment[]              @relation("TicketCommentAuthorUser")

  pages Page[]

  @@unique([email])
  @@map("user")
  @@schema("public")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
  @@schema("public")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
  @@schema("public")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verification")
  @@schema("public")
}

/// Better Auth credential rate limits. `lastRequest` is epoch milliseconds.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
  @@schema("public")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  spaces      Space[]
  billing     BillingAccount?

  @@unique([slug])
  @@map("organization")
  @@schema("public")
}

model BillingAccount {
  organizationId      String       @id
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId          String       @unique
  subscriptionId      String?
  subscriptionItemId  String?
  priceId             String?
  status              String?
  seats               Int?
  trialEndsAt         DateTime?
  currentPeriodEndsAt DateTime?
  cancelAtPeriodEnd   Boolean      @default(false)
  endedAt             DateTime?
  subscribedAt        DateTime?
  syncedAt            DateTime?
  statusRefreshStartedAt DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("billing_accounts")
  @@schema("public")
}

model ActionApprovalRule {
  id              String   @id @default(cuid())
  spaceId         String
  space           Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  effect          String
  matchKind       String
  matchValue      String
  createdAt       DateTime @default(now())

  @@unique([spaceId, createdByUserId, effect, matchKind, matchValue])
  @@index([spaceId, createdByUserId])
  @@map("action_approval_rules")
  @@schema("public")
}

model ActionAutoReviewPreference {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([spaceId, userId])
  @@map("action_auto_review_preferences")
  @@schema("public")
}

model Member {
  id               String        @id
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             String
  createdAt        DateTime
  spaceMemberships SpaceMember[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
  @@schema("public")
}

model Space {
  botPackagePreviews BotPackagePreview[]
  botPackageImports BotPackageImport[]
  openApiImportReceipts OpenApiImportReceipt[]
  aiDataConsents AiDataConsent[]
  id                          String                       @id
  organizationId              String
  organization                Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                        String
  isDefault                   Boolean                      @default(false)
  createdByUserId             String?
  createdByUser               User?                        @relation("SpaceCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt                   DateTime                     @default(now())
  deletingAt                  DateTime?
  deletionClaimId             String?
  allowBotCollaboration       Boolean                      @default(true)
  collaborationRevision       Int                          @default(0)
  collaborationAudit          SpaceCollaborationChange[]
  memberships                 SpaceMember[]
  bots                        Bot[]
  botSections                 BotSection[]
  botDeletions                BotDeletion[]
  threads                     Thread[]
  events                      Event[]
  tasks                       Task[]
  runs                        Run[]
  routines                    Routine[]
  scratchpadItems             ScratchpadItem[]
  taughtSkills                TaughtSkill[]
  agentSkills                 AgentSkill[]
  connections                 Connection[]
  capabilities                CapabilityInstall[]
  memoryDocuments             MemoryDocument[]
  agentHomes                  AgentHome[]
  browserProfiles             BrowserProfile[]
  artifacts                   Artifact[]
  usageRecords                UsageRecord[]
  notificationPreferences     NotificationPreference[]
  computers                   Computer[]
  externalEffects             ExternalEffect[]
  mcpServers                  McpServer[]
  mcpOAuthSessions            McpOAuthSession[]
  botMcpServers               BotMcpServer[]
  messagingIdentities         MessagingIdentity[]
  actionApprovalRules         ActionApprovalRule[]
  actionAutoReviewPreferences ActionAutoReviewPreference[]
  memoryConfig                SpaceMemoryConfig?
  secrets                     Secret[]
  nativeOAuthSessions         NativeOAuthSession[]
  nativeOAuthGrants           NativeOAuthGrant[]
  chatGroups                  ChatGroup[]
  botSecrets BotSecret[]
  externalConversations       ExternalConversation[]
  agentSecrets                AgentSecret[]
  board                       Board?
  tickets                     Ticket[]
  ticketComments              TicketComment[]

  pages Page[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([createdByUserId])
  @@map("spaces")
  @@schema("public")
}

model SpaceMember {
  id               String                 @id
  spaceId          String
  organizationId   String
  space            Space                  @relation(fields: [spaceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  userId           String
  member           Member                 @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)
  role             String                 @default("member")
  createdAt        DateTime
  modelPreferences SpaceModelPreference[]
  voicePreferences SpaceVoicePreference[]
  aiDataConsents AiDataConsent[]
  backupModels SpaceBackupModel[]

  @@unique([spaceId, userId])
  @@index([organizationId, userId])
  @@index([userId, createdAt])
  @@map("space_members")
  @@schema("public")
}

model SpaceCollaborationChange {
  id              String   @id @default(cuid())
  spaceId         String
  space           Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  actorUserId     String
  previousAllowed Boolean
  allowed         Boolean
  revision        Int
  createdAt       DateTime @default(now())

  @@unique([spaceId, revision])
  @@map("space_collaboration_changes")
  @@schema("public")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
  @@schema("public")
}

model DeploymentSettings {
  id                              String   @id @default("default")
  ownerUserId                     String?
  signupsEnabled                  Boolean  @default(true)
  signupAllowlist                 String   @default("")
  signupPolicyInitialized         Boolean  @default(false)
  defaultModelProvider            String?
  defaultModelId                  String?
  deploymentModelCredentialCipher String?
  computerHost                    String?
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  @@map("deployment_settings")
  @@schema("public")
}

model UserModelCredential {
  id          String                 @id @default(cuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String
  label       String
  secretId    String
  supportsImages Boolean              @default(false)
  connectionRevision Int              @default(1)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  preferences SpaceModelPreference[]

  @@unique([id, userId])
  @@index([userId, provider, updatedAt])
  @@map("user_model_credentials")
  @@schema("public")
}

model UserVoiceCredential {
  id          String                 @id @default(cuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String
  secretId    String
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  preferences SpaceVoicePreference[]

  @@unique([id, userId])
  @@index([userId, provider, updatedAt])
  @@map("user_voice_credentials")
  @@schema("public")
}

model SpaceModelPreference {
  id           String              @id @default(cuid())
  spaceId      String
  userId       String
  spaceMember  SpaceMember         @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  credentialId String
  credential   UserModelCredential @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Cascade)
  modelId      String?
  thinkingLevel String?
  isDefault    Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([spaceId, userId, credentialId])
  @@index([spaceId, userId, isDefault, updatedAt])
  @@index([credentialId])
  // Partial unique index space_model_preferences_default_key is created in SQL.
  @@map("space_model_preferences")
  @@schema("public")
}

model SpaceBackupModel {
  spaceId     String
  userId      String
  spaceMember SpaceMember @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  provider    String
  modelId     String
  modelCredentialId String?
  position    Int

  @@id([spaceId, userId, position])
  @@unique([spaceId, userId, modelCredentialId, provider, modelId], map: "space_backup_models_connection_model_key")
  @@map("space_backup_models")
  @@schema("public")
}

model SpaceVoicePreference {
  id           String              @id @default(cuid())
  spaceId      String
  userId       String
  spaceMember  SpaceMember         @relation(fields: [spaceId, userId], references: [spaceId, userId], onDelete: Cascade)
  credentialId String
  credential   UserVoiceCredential @relation(fields: [credentialId, userId], references: [id, userId], onDelete: Cascade)
  voiceId      String              @default("")
  // Fish speech-model override. Null keeps the deployment default.
  speechModel  String?
  isDefault    Boolean             @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([spaceId, userId, credentialId])
  @@index([spaceId, userId, isDefault, updatedAt])
  @@index([credentialId])
  // Partial unique index space_voice_preferences_default_key is created in SQL.
  @@map("space_voice_preferences")
  @@schema("public")
}

model Bot {
  packageImport BotPackageImport?
  packageComponents BotPackageComponent[]
  screenGeneration Int @default(0)
  id                String            @id @default(cuid())
  spaceId           String
  space             Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId            String
  name              String
  title             String            @default("")
  description       String            @default("")
  instructions      String            @default("")
  color             String
  notifyOnFinish    Boolean           @default(true)
  pinned            Boolean           @default(false)
  position          Int               @default(0)
  sectionId         String?
  section           BotSection?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  archivedAt        DateTime?
  parentBotId       String?
  spawnKey          String?
  memoryScope       String?
  parent            Bot?              @relation("BotChildren", fields: [parentBotId], references: [id], onDelete: SetNull)
  children          Bot[]             @relation("BotChildren")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  thread            Thread?
  computerId        String?
  computer          Computer?         @relation(fields: [computerId], references: [id], onDelete: SetNull)
  computerSwitching Boolean           @default(false)
  voiceId           String?
  autoSpeak         Boolean           @default(false)
  modelProvider     String?
  modelId           String?
  modelCredentialId String?
  thinkingLevel     String?
  disabledBuiltinTools String[] @default([])
  webhookSecretId   String?
  teamChatAmbientEnabled Boolean @default(false)
  teamChatRules          String  @default("")
  routines          Routine[]
  scratchpadItems   ScratchpadItem[]
  taughtSkills      TaughtSkill[]
  memoryDocuments   MemoryDocument[]
  agentHome         AgentHome?
  browserProfile    BrowserProfile?
  artifacts         Artifact[]
  tasks             Task[]
  runs              Run[]
  steeringMessages  SteeringMessage[]
  mcpServers        BotMcpServer[]
  groupMembers      ChatGroupMember[]
  botSecrets BotSecret[]
  assignedTickets   Ticket[]          @relation("TicketAssigneeBot")
  createdTickets    Ticket[]          @relation("TicketCreatorBot")
  ticketComments    TicketComment[]   @relation("TicketCommentAuthorBot")

  externalConversations ExternalConversation[]

  pages Page[]

  @@unique([spaceId, spawnKey])
  @@index([spaceId, userId, archivedAt, pinned, updatedAt])
  @@index([sectionId])
  @@index([computerId])
  @@index([parentBotId])
  @@map("bots")
  @@schema("public")
}

model BotPackagePreview {
  id                   String @id @default(cuid())
  tokenHash            String @unique
  spaceId              String
  space                Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId               String
  user                 User @relation(fields: [userId], references: [id], onDelete: Cascade)
  digest               String
  sourceFormat         String
  document             Json
  leftOut              Json
  includeMemory        Boolean @default(false)
  availableMemoryCount Int @default(0)
  expiresAt            DateTime
  createdAt            DateTime @default(now())

  @@index([spaceId, userId, expiresAt])
  @@index([expiresAt, id])
  @@map("bot_package_previews")
  @@schema("public")
}

model BotPackageImport {
  id               String @id @default(cuid())
  spaceId          String
  space            Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId           String
  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientNonce      String
  previewTokenHash String? @unique
  digest           String @default("")
  status           String @default("importing")
  revision         Int @default(1)
  botId            String? @unique
  bot              Bot? @relation(fields: [botId], references: [id], onDelete: SetNull)
  botName          String @default("")
  plan             Json?
  leftOut          Json @default("[]")
  skillCount       Int @default(0)
  connectionCount  Int @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  components       BotPackageComponent[]

  @@unique([spaceId, userId, clientNonce])
  @@index([spaceId, userId, createdAt])
  @@map("bot_package_imports")
  @@schema("public")
}

model BotPackageComponent {
  id            String @id @default(cuid())
  importId      String
  import        BotPackageImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  botId         String
  bot           Bot @relation(fields: [botId], references: [id], onDelete: Cascade)
  key           String
  kind          String
  name          String
  description   String @default("")
  content       String?
  status        String @default("pending")
  revision      Int @default(1)
  targetSkillId String?
  activationBinding String?

  @@unique([importId, key])
  @@index([botId])
  @@map("bot_package_components")
  @@schema("public")
}

model BotSection {
  id        String      @id @default(cuid())
  spaceId   String
  space     Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  position  Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  bots      Bot[]
  groups    ChatGroup[]

  @@unique([spaceId, userId, name])
  @@index([spaceId, userId, position, createdAt])
  @@map("bot_sections")
  @@schema("public")
}

model BotDeletion {
  id                String   @id
  spaceId           String
  space             Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name              String
  deletedByUserId   String
  memoriesPreserved Boolean
  deletedAt         DateTime @default(now())

  @@index([spaceId, deletedAt])
  @@map("bot_deletions")
  @@schema("public")
}

model ChatGroup {
  id                String            @id @default(cuid())
  spaceId           String
  space             Space             @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId            String
  name              String
  clientNonce       String?
  creationSignature String?
  pinned            Boolean           @default(false)
  sectionId         String?
  section           BotSection?       @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  archivedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  members           ChatGroupMember[]
  thread            Thread?
  artifacts         Artifact[]

  pages Page[]

  @@unique([spaceId, userId, clientNonce])
  @@index([spaceId, userId, archivedAt, pinned, updatedAt])
  @@index([sectionId])
  @@map("chat_groups")
  @@schema("public")
}

model ChatGroupMember {
  id        String    @id @default(cuid())
  groupId   String
  group     ChatGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot       @relation(fields: [botId], references: [id], onDelete: NoAction)
  createdAt DateTime  @default(now())

  @@unique([groupId, botId])
  @@index([botId])
  @@map("chat_group_members")
  @@schema("public")
}

model Thread {
  id                          String     @id @default(cuid())
  spaceId                     String
  space                       Space      @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId                       String?    @unique
  bot                         Bot?       @relation(fields: [botId], references: [id], onDelete: Cascade)
  groupId                     String?    @unique
  group                       ChatGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  externalConversationId      String?    @unique
  externalConversation        ExternalConversation? @relation(fields: [externalConversationId], references: [id], onDelete: Cascade)
  userId                      String
  createdAt                   DateTime   @default(now())
  nextEventSeq                Int        @default(0)
  nextMessageSeq              Int        @default(0)
  historyCompactedUpToSeq     Int?
  historyCompactionSummary    String?    @db.Text
  historyCompactionGeneration Int        @default(0)
  unread                      Boolean    @default(false)
  messages                    Message[]
  events                      Event[]
  tasks                       Task[]
  runs                        Run[]
  routines                    Routine[]

  @@index([spaceId])
  @@map("threads")
  @@schema("public")
}

model Message {
  id               String    @id @default(cuid())
  threadId         String
  thread           Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  seq              Int
  role             String
  /// Authenticated in-product author, if this message was directly sent by a user.
  authorUserId     String?
  blocks           Json
  botId            String?
  replyToMessageId String?
  replyQuote       String?
  replyTo          Message?  @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          Message[] @relation("MessageReplies")
  runId            String?
  clientNonce      String?
  sourceRuns            Run[]             @relation("RunSourceMessage")
  externalTranscriptFor  ExternalMessage?
  steeringMessages SteeringMessage[]
  createdAt        DateTime  @default(now())

  @@unique([threadId, seq])
  @@unique([threadId, clientNonce])
  @@index([threadId, seq])
  @@index([replyToMessageId])
  @@map("messages")
  @@schema("public")
}

model Event {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  botId     String
  seq       Int
  type      String
  payload   Json
  // Private result storage; never part of the replayed ProductEvent payload.
  toolResult Json?
  runId     String?
  createdAt DateTime @default(now())

  @@unique([threadId, seq])
  @@index([spaceId, createdAt])
  @@index([threadId, seq])
  @@index([runId, type, seq])
  @@map("events")
  @@schema("public")
}

model Task {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  prompt    String
  /// Owner instructions captured before adding skill content or event data.
  routineInstructions String?
  /// Sites authorized for this Routine before the Run was queued.
  routineSites String[] @default([])
  status    String
  connectionIds String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs      Run[]

  @@index([spaceId, botId])
  @@map("tasks")
  @@schema("public")
}

model Run {
  id                   String           @id @default(cuid())
  spaceId              String
  space                Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  botId                String
  bot                  Bot              @relation(fields: [botId], references: [id], onDelete: Cascade)
  threadId             String
  thread               Thread           @relation(fields: [threadId], references: [id], onDelete: Cascade)
  taskId               String
  task                 Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId               String
  status               String
  trigger              String
  /// Trusted dispatch classification, independent of user-visible trigger names.
  origin               String           @default("human")
  parentRunId          String?
  collaborationSourceSpaceId String?
  collaborationSourceBotId String?
  collaborationSourceRevision Int?
  collaborationRevision Int?
  collaborationMessageId String?
  /// Delivery state, not a new Run lifecycle state.
  collaborationStatus  String?
  modelProvider        String?
  modelId              String?
  modelCredentialId    String?
  thinkingLevel        String?
  // True when these columns are the model the run must keep. A later attempt
  // may record the model it used in the same columns without setting this.
  modelPinned          Boolean          @default(false)
  error                String?
  leaseOwner           String?
  leaseFence           Int              @default(0)
  leaseExpiresAt       DateTime?
  checkpoint           String?
  scriptedState        Json?
  clientNonce          String?
  sourceMessageId      String?
