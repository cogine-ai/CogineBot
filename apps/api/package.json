    "@rakazo/auth": "workspace:*",
    "@rakazo/contracts": "workspace:*",
    "@rakazo/core": "workspace:*",
    "@rakazo/db": "workspace:*",
    "@rakazo/logging": "workspace:*",
    "@rakazo/page-kit": "workspace:*",
    "@rakazo/memory": "workspace:*",
    "hono": "4.13.18",
    "mermaid": "11.17.2",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "4.1.11"
