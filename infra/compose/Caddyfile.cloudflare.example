{
	order abort first
	# Caddy can log the original URL even when the upstream never responds.
	log {
		format filter {
			request>uri regexp `(?i)^[^?]*(/+(p|api/+v1/+pages/+shared)(/|[?]|$)|%[0-9a-f]{2}|\\|/\.\.?(/|[?]|$)).*` [redacted-uri]
			request>headers>Referer regexp `(?i)^[^?]*(/+(p|api/+v1/+pages/+shared)(/|[?]|$)|%[0-9a-f]{2}|\\|/\.\.?(/|[?]|$)).*` [redacted-uri]
		}
	}
}

(cloudflare_only) {
	# Keep in sync with https://www.cloudflare.com/ips/.
	@direct_origin not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	abort @direct_origin
}

(deploy_retry) {
	lb_try_duration 10s
	lb_try_interval 250ms
}

(shared_page_privacy) {
	Cache-Control no-store
	Referrer-Policy no-referrer
	X-Robots-Tag "noindex, nofollow"
}

(shared_page_headers) {
	@sharedPage path /p /p/* /api/v1/pages/shared /api/v1/pages/shared/*
	# Set on an origin failure, and replace any upstream values on successful proxying.
	header @sharedPage {
		import shared_page_privacy
	}
	header @sharedPage {
		import shared_page_privacy
		defer
	}
}

http://{$RAKAZO_HOST:app.example.com} {
	import cloudflare_only
	import shared_page_headers
	redir https://{$RAKAZO_HOST:app.example.com}{uri} 308
}

:80 {
	abort
}

{$RAKAZO_HOST:app.example.com} {
	import cloudflare_only
	encode zstd gzip
	import shared_page_headers

	# A localhost trial must not pin HTTPS onto every local dev server.
	@hsts not host localhost 127.0.0.1
	header @hsts Strict-Transport-Security "max-age=31536000"
	# SAMEORIGIN still lets the app frame its own /novnc/ screen.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
	}

	handle /health {
		reverse_proxy api:3100 {
			import deploy_retry
		}
	}

	handle /api/* {
		reverse_proxy api:3100 {
			import deploy_retry
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}

	handle /rpc/* {
		reverse_proxy api:3100 {
			import deploy_retry
		}
	}

	handle {
		reverse_proxy web:5173 {
			import deploy_retry
		}
	}
}
