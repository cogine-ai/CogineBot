{
	# Caddy can log the original URL even when the upstream never responds.
	log {
		format filter {
			request>uri regexp `(?i)^[^?]*(/+(p|api/+v1/+pages/+shared)(/|[?]|$)|%[0-9a-f]{2}|\\|/\.\.?(/|[?]|$)).*` [redacted-uri]
			request>headers>Referer regexp `(?i)^[^?]*(/+(p|api/+v1/+pages/+shared)(/|[?]|$)|%[0-9a-f]{2}|\\|/\.\.?(/|[?]|$)).*` [redacted-uri]
		}
	}
}

(deploy_retry) {
	lb_try_duration 10s
	lb_try_interval 250ms
}

(shared_page_privacy) {
	Cache-Control no-store
	Referrer-Policy no-referrer
	X-Robots-Tag "noindex, nofollow"
}

(shared_page_headers) {
	@sharedPage path /p /p/* /api/v1/pages/shared /api/v1/pages/shared/*
	# Set on an origin failure, and replace any upstream values on successful proxying.
	header @sharedPage {
		import shared_page_privacy
	}
	header @sharedPage {
		import shared_page_privacy
		defer
	}
}

{$RAKAZO_HOST:app.example.com} {
	encode zstd gzip
	import shared_page_headers

	# A localhost trial must not pin HTTPS onto every local dev server.
	@hsts not host localhost 127.0.0.1
	header @hsts Strict-Transport-Security "max-age=31536000"
	# SAMEORIGIN still lets the app frame its own /novnc/ screen.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
	}

	handle /health {
		reverse_proxy api:3100 {
			import deploy_retry
		}
	}

	handle /api/* {
		reverse_proxy api:3100 {
			import deploy_retry
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle /rpc/* {
		reverse_proxy api:3100 {
			import deploy_retry
		}
	}

	handle {
		reverse_proxy web:5173 {
			import deploy_retry
		}
	}
}
